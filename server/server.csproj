      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Mqtt.Controllers" Version="0.1.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
    <PackageReference Include="NSwag.AspNetCore" Version="14.6.3" />
    <PackageReference Include="StateleSSE.AspNetCore" Version="4.0.0-preview.1" />
  </ItemGroup>


  <ItemGroup>
    <Folder Include="api\Etc\" />
